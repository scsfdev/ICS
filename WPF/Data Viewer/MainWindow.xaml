<Window x:Class="Data_Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ignore="http://www.galasoft.ch/ignore"
        mc:Ignorable="d ignore"
        Height="600"
        Width="800"
        Title="{Binding TITLE}"
        DataContext="{Binding Main, Source={StaticResource Locator}}" Icon="Resources/LiveData.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Skins/MainSkin.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Background="GhostWhite" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="33"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="123*"/>
            <RowDefinition Height="123*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="Gainsboro" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0">
                    <Label Content="Refresh interval:   5 seconds" Style="{StaticResource LblMenuLeft}" Margin="0,0,5,0"/>
                    <ToggleButton Margin="5,0,25,0" Style="{StaticResource AnimatedSwitch}" Height="25" 
                                  Command="{Binding CmdToggle}" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}"/>
                    <Label Content="10 seconds" Style="{StaticResource LblMenuLeft}" Margin="5,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0" ToolTip="{Binding User_Status}">
                    <Image Height="25" Width="25" Source="/images/idicon.png"/>
                    <Label Name="lblUserID" Content="{Binding User_Name}" Style="{StaticResource LblMenuLeft}" Margin="0,2,0,0" />
                </StackPanel>


                <StackPanel Grid.Column="2" ToolTip="{Binding DbStatusMsg}" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Label FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Padding="5,0,0,0" Content="DB: " Style="{StaticResource LblMenuLeft}" Margin="0,2,0,0" />
                    <Image Name="imgDBStatus" Height="25" Width="25" Source="{Binding DbStatusIndicator}" />
                </StackPanel>
            </Grid>
        </Border>

        <Label Style="{StaticResource LblCenter}" Grid.Row="1" FontSize="30" Grid.ColumnSpan="2" Content="{Binding DataAsOf}" />

        <Border Grid.Row="2" Grid.Column="0" Margin="5" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B94F3" Offset="0"/>
                    <GradientStop Color="#FFABB2B8" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFC6E3F7" Offset="0"/>
                        <GradientStop Color="#FFFDFDFD" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Label Grid.Row="0" Style="{StaticResource LblCenter}" Content="INCOMING SHIPMENT" />
                <DataGrid Grid.Row="1" CellStyle="{StaticResource DGCStyle}" x:Name="dgIncoming" RowHeaderWidth="0" Margin="5" FontFamily="DENSO"
                          AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" AlternatingRowBackground="AliceBlue" AlternationCount="2" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="True" Tag="{Binding TAG_INCOMING}"
                          ItemsSource="{Binding ListIncoming}" SelectedItem="{Binding SelectedIncoming}"  >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="Rec ID" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="50"  Width="80" 
                                            Binding="{Binding RecID}" Visibility="Collapsed"/>
                        
                        <DataGridTextColumn IsReadOnly="True" Header="Date" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="100" MaxWidth="200" Width="100" 
                                            Binding="{Binding ShipDate}" Visibility="Collapsed" />

                        <DataGridTextColumn IsReadOnly="True" Header="Shipment No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200"  Width="150" 
                                            Binding="{Binding ShipNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Supplier No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200" Width="200"
                                            Binding="{Binding SupplierNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Part No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="150" Width="200" 
                                            Binding="{Binding PartNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Qty" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="120" MaxWidth="200" Width="100" 
                                            Binding="{Binding Qty}" />
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Margin="5" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B94F3" Offset="0"/>
                    <GradientStop Color="#FFABB2B8" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFC6E3F7" Offset="0"/>
                        <GradientStop Color="#FFFDFDFD" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Label Grid.Row="0" Style="{StaticResource LblCenter}" Content="OUTGOING SHIPMENT" />
                <DataGrid Grid.Row="1" CellStyle="{StaticResource DGCStyle}" x:Name="dgOutgoing" RowHeaderWidth="0" Margin="5" FontFamily="DENSO"
                          AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" AlternatingRowBackground="AliceBlue" AlternationCount="2" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="True" Tag="{Binding TAG_OUTGOING}"
                          ItemsSource="{Binding ListOutgoing}" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="Rec ID" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="50"  Width="80" 
                                            Binding="{Binding RecID}" Visibility="Collapsed"/>

                        <DataGridTextColumn IsReadOnly="True" Header="Date" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="100" MaxWidth="200" Width="100" 
                                            Binding="{Binding ShipDate}" Visibility="Collapsed" />

                        <DataGridTextColumn IsReadOnly="True" Header="Order No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200"  Width="150" 
                                            Binding="{Binding OrderNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Customer No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200" Width="200"
                                            Binding="{Binding CustomerNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Part No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="150" Width="200" 
                                            Binding="{Binding PartNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Qty" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="120" MaxWidth="200" Width="100" 
                                            Binding="{Binding Qty}" />
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="0" Margin="5" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B94F3" Offset="0"/>
                    <GradientStop Color="#FFABB2B8" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid >
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFF7EEC6" Offset="0"/>
                        <GradientStop Color="#FFFDFDFD" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Style="{StaticResource LblCenter}" Content="STOCK IN" Foreground="DarkRed" />
                <DataGrid Grid.Row="1" CellStyle="{StaticResource DGCStyle}" x:Name="dgStockIn" RowHeaderWidth="0" Margin="5" FontFamily="DENSO"
                          AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" AlternatingRowBackground="AliceBlue" AlternationCount="2" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="True" Tag="{Binding TAG_STOCKIN}"
                          ItemsSource="{Binding ListStockIn}" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="Rec ID" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="50"  Width="80" 
                                            Binding="{Binding RecID}" Visibility="Collapsed"/>

                        <DataGridTextColumn IsReadOnly="True" Header="Move Date" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200" Width="200"
                                            Binding="{Binding MoveDate}" Visibility="Collapsed" />

                        <DataGridTextColumn IsReadOnly="True" Header="Location" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="100" Width="150" 
                                            Binding="{Binding LocID}" />
                        
                        <DataGridTextColumn IsReadOnly="True" Header="Part No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="150" Width="200" 
                                            Binding="{Binding PartNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Qty" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="120" MaxWidth="200" Width="100" 
                                            Binding="{Binding InQty}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.Column="1" Margin="5" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF0B94F3" Offset="0"/>
                    <GradientStop Color="#FFABB2B8" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid >
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFF7EEC6" Offset="0"/>
                        <GradientStop Color="#FFFDFDFD" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Style="{StaticResource LblCenter}" Content="STOCK OUT" Foreground="DarkRed" />
                <DataGrid Grid.Row="1" CellStyle="{StaticResource DGCStyle}" x:Name="dgStockOut" RowHeaderWidth="0" Margin="5" FontFamily="DENSO"
                          AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserAddRows="False" AlternatingRowBackground="AliceBlue" AlternationCount="2" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow" IsEnabled="True" Tag="{Binding TAG_STOCKOUT}"
                          ItemsSource="{Binding ListStockOut}" >
                    <DataGrid.Columns>
                        <DataGridTextColumn IsReadOnly="True" Header="Rec ID" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="50"  Width="80" 
                                            Binding="{Binding RecID}" Visibility="Collapsed"/>

                        <DataGridTextColumn IsReadOnly="True" Header="Move Date" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="200" Width="200"
                                            Binding="{Binding MoveDate}" Visibility="Collapsed" />

                        <DataGridTextColumn IsReadOnly="True" Header="Location" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="100" Width="150" 
                                            Binding="{Binding LocID}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Part No" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="150" Width="200" 
                                            Binding="{Binding PartNo}" />

                        <DataGridTextColumn IsReadOnly="True" Header="Qty" HeaderStyle="{StaticResource DGCHeaderStyle}" ElementStyle="{StaticResource DGCElementStyle}" MinWidth="120" MaxWidth="200" Width="100" 
                                            Binding="{Binding OutQty}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
