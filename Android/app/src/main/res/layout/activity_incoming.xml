<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IncomingActivity">


    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:columnCount="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_gravity="fill_horizontal"
            android:gravity="end"
            android:text="@string/date"
            android:textColor="@color/colorMidnightBlue" />

        <TextView
            android:id="@+id/tvOutDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_marginLeft="10dp"
            android:text="2018/08/07" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:gravity="end"
            android:text="@string/shipmentNo"
            android:textColor="@color/colorMidnightBlue" />

        <EditText
            android:id="@+id/etInSHNO"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_marginLeft="10dp"
            android:maxLength="10"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_gravity="fill_horizontal"
            android:gravity="end"
            android:text="@string/supplierCode"
            android:textColor="@color/colorMidnightBlue" />

        <EditText
            android:id="@+id/etInSupNo"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_marginLeft="10dp"
            android:maxLength="10"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_gravity="fill_horizontal"
            android:gravity="end"
            android:text="@string/part_no"
            android:textColor="@color/colorMidnightBlue" />

        <EditText
            android:id="@+id/etInPNO"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:maxLength="10"
            android:layout_marginLeft="10dp"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_gravity="fill_horizontal"
            android:gravity="end"
            android:text="@string/qty"
            android:textColor="@color/colorMidnightBlue" />

        <EditText
            android:id="@+id/etInQty"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_marginLeft="10dp"
            android:inputType="number"
            android:maxLength="5"
            android:maxLines="1" />
    </GridLayout>

    <ListView
        android:id="@+id/lstView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:isScrollContainer="false"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout">

    </ListView>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnInClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="clearForm"
            android:text="@string/clear" />

        <Button
            android:id="@+id/btnInSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:onClick="saveForm"
            android:text="@string/save" />
    </LinearLayout>


</android.support.constraint.ConstraintLayout>